{
  "name": "qed-standard",
  "version": "1.0.3",
  "description": "Q.E.D. (Quod Erat Demonstrandum) High-Assurance Engineering Standard & Mechanical Verification Engine",
  "main": "bin/qed-engine.js",
  "bin": {
    "qed": "bin/qed-engine.js",
    "qed-standard": "bin/qed-engine.js"
  },
  "files": [
    "bin",
    "core",
    "adapters",
    "docs",
    "schema",
    "evals",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "README.md",
    "README.ru.md",
    "README.zh-CN.md",
    "assets",
    "llms.txt",
    "QED.lite.md"
  ],
  "scripts": {
    "lint": "node bin/qed-engine.js check",
    "check": "node bin/qed-engine.js check",
    "test": "node bin/qed-engine.js test",
    "doctor": "node bin/qed-engine.js doctor",
    "ci": "node bin/qed-engine.js ci-watch",
    "tokens": "node bin/qed-engine.js tokens",
    "evals": "node evals/run-benchmark.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "node bin/qed-engine.js check && node bin/qed-engine.js test"
